{
  "meta": {
    "instanceId": "smart-blog-factory-v2"
  },
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerInterval": "hours",
              "hoursBetweenTriggers": 3
            }
          ]
        }
      },
      "id": "1",
      "name": "Blog Factory Timer",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        100,
        400
      ]
    },
    {
      "parameters": {
        "resource": "sheet",
        "operation": "read",
        "documentId": {
          "mode": "id",
          "value": "={{ $vars.GOOGLE_SHEET_ID }}"
        },
        "sheetName": {
          "mode": "name",
          "value": "Blog Titles"
        },
        "range": "A:B",
        "options": {
          "headerRow": true
        }
      },
      "id": "2",
      "name": "Fetch Blog Ideas",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        300,
        400
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "google-sheets-oauth",
          "name": "Google Sheets OAuth2"
        }
      }
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "3",
      "name": "Process One by One",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        500,
        400
      ]
    },
    {
      "parameters": {
        "resource": "text",
        "operation": "message",
        "modelId": {
          "mode": "name",
          "value": "gemini-1.5-flash"
        },
        "messages": {
          "values": [
            {
              "content": "Write a comprehensive, SEO-optimized blog post about: {{ $json.title }}\n\nCategory: {{ $json.category || 'Technology' }}\n\nRequirements:\n- 1000-1500 words\n- Include H2 and H3 headings with proper HTML tags\n- Write in professional, engaging tone\n- Include actionable insights and examples\n- Add compelling introduction and conclusion\n- Optimize for SEO with relevant keywords\n- Use proper HTML formatting (p, h2, h3, ul, li tags)\n\nReturn the content as a well-structured HTML blog post."
            }
          ]
        }
      },
      "id": "4",
      "name": "AI Content Writer",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1,
      "position": [
        700,
        400
      ],
      "credentials": {
        "googleGeminiOAuth2Api": {
          "id": "google-gemini-oauth",
          "name": "Google Gemini OAuth2"
        }
      }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.unsplash.com/search/photos",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "query",
              "value": "={{ $json.title }}"
            },
            {
              "name": "per_page",
              "value": "1"
            },
            {
              "name": "orientation",
              "value": "landscape"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Client-ID {{ $vars.UNSPLASH_ACCESS_KEY }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "5",
      "name": "Image Hunter",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        400
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "title",
              "name": "title",
              "value": "={{ $('Process One by One').item(0).json.title }}",
              "type": "string"
            },
            {
              "id": "slug",
              "name": "slug",
              "value": "={{ $('Process One by One').item(0).json.title.toLowerCase().replace(/[^a-z0-9 -]/g, '').replace(/\\s+/g, '-').replace(/-+/g, '-').substring(0, 100) }}",
              "type": "string"
            },
            {
              "id": "content",
              "name": "content",
              "value": "={{ $('AI Content Writer').item(0).json.response || $('AI Content Writer').item(0).json.text || $('AI Content Writer').item(0).json.content || 'Generated content' }}",
              "type": "string"
            },
            {
              "id": "excerpt",
              "name": "excerpt",
              "value": "={{ ($('AI Content Writer').item(0).json.response || $('AI Content Writer').item(0).json.text || $('AI Content Writer').item(0).json.content || 'Generated content').substring(0, 150) + '...' }}",
              "type": "string"
            },
            {
              "id": "featured_image",
              "name": "featured_image",
              "value": "={{ $json.results && $json.results.length > 0 ? $json.results[0].urls.regular : null }}",
              "type": "string"
            },
            {
              "id": "category",
              "name": "category",
              "value": "={{ $('Process One by One').item(0).json.category || 'Technology' }}",
              "type": "string"
            },
            {
              "id": "tags",
              "name": "tags",
              "value": "=['automated', 'blog', 'ai-generated']",
              "type": "array"
            },
            {
              "id": "author_id",
              "name": "author_id",
              "value": "=1",
              "type": "number"
            },
            {
              "id": "status",
              "name": "status",
              "value": "draft",
              "type": "string"
            },
            {
              "id": "is_featured",
              "name": "is_featured",
              "value": "=false",
              "type": "boolean"
            },
            {
              "id": "published_at",
              "name": "published_at",
              "value": "=null",
              "type": "string"
            },
            {
              "id": "created_at",
              "name": "created_at",
              "value": "={{ new Date().toISOString() }}",
              "type": "string"
            },
            {
              "id": "updated_at",
              "name": "updated_at",
              "value": "={{ new Date().toISOString() }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false
      },
      "id": "6",
      "name": "Format Blog Post",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1100,
        400
      ]
    },
    {
      "parameters": {
        "resource": "database",
        "operation": "insert",
        "schema": {
          "mode": "name",
          "value": "public"
        },
        "table": {
          "mode": "name",
          "value": "blog_posts"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "title": "={{ $json.title }}",
            "slug": "={{ $json.slug }}",
            "content": "={{ $json.content }}",
            "excerpt": "={{ $json.excerpt }}",
            "featured_image": "={{ $json.featured_image }}",
            "category": "={{ $json.category }}",
            "tags": "={{ $json.tags }}",
            "author_id": "={{ $json.author_id }}",
            "status": "={{ $json.status }}",
            "is_featured": "={{ $json.is_featured }}",
            "published_at": "={{ $json.published_at }}",
            "created_at": "={{ $json.created_at }}",
            "updated_at": "={{ $json.updated_at }}"
          }
        }
      },
      "id": "7",
      "name": "Save to Database",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1300,
        400
      ],
      "credentials": {
        "postgres": {
          "id": "postgres-db",
          "name": "PostgreSQL Database"
        }
      }
    }
  ],
  "connections": {
    "Blog Factory Timer": {
      "main": [
        [
          {
            "node": "Fetch Blog Ideas",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Blog Ideas": {
      "main": [
        [
          {
            "node": "Process One by One",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Process One by One": {
      "main": [
        [
          {
            "node": "AI Content Writer",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI Content Writer": {
      "main": [
        [
          {
            "node": "Image Hunter",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Image Hunter": {
      "main": [
        [
          {
            "node": "Format Blog Post",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Blog Post": {
      "main": [
        [
          {
            "node": "Save to Database",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Save to Database": {
      "main": [
        [
          {
            "node": "Process One by One",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [],
  "triggerCount": 1,
  "updatedAt": "2025-01-08T16:00:00.000Z",
  "versionId": "2"
}