{
  "name": "Automated Blog Post Creation",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Every 6 Hours Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "resource": "sheet",
        "operation": "read",
        "documentId": "={{ $env.GOOGLE_SHEET_ID }}",
        "sheetName": "Sheet1",
        "range": "A:C",
        "options": {
          "dataStructure": "object"
        }
      },
      "id": "google-sheets",
      "name": "Get Blog Titles from Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.6,
      "position": [
        460,
        300
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "google-sheets-oauth",
          "name": "Google Sheets OAuth2 API"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Select a random blog title from the sheet\nconst items = $input.all();\n\n// Filter out empty rows and already used titles\nconst availableTitles = items.filter(item => \n  item.json.Title && \n  item.json.Title.trim() !== '' && \n  (!item.json.Status || item.json.Status.toLowerCase() !== 'published')\n);\n\nif (availableTitles.length === 0) {\n  throw new Error('No available blog titles found in the sheet');\n}\n\n// Select a random title\nconst randomIndex = Math.floor(Math.random() * availableTitles.length);\nconst selectedTitle = availableTitles[randomIndex];\n\n// Add row number for later update\nconst originalIndex = items.findIndex(item => \n  item.json.Title === selectedTitle.json.Title\n);\n\nreturn [{\n  json: {\n    title: selectedTitle.json.Title,\n    category: selectedTitle.json.Category || 'General',\n    rowNumber: originalIndex + 2, // +2 because sheets are 1-indexed and we assume header row\n    keywords: selectedTitle.json.Keywords || selectedTitle.json.Title\n  }\n}];"
      },
      "id": "select-title",
      "name": "Select Random Title",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "resource": "text",
        "operation": "message",
        "modelId": {
          "value": "gemini-1.5-flash",
          "mode": "list"
        },
        "messages": {
          "values": [
            {
              "content": "=Write a comprehensive, engaging blog post about \"{{ $json.title }}\". \n\nRequirements:\n- Write 800-1200 words\n- Include an engaging introduction\n- Use proper headings and subheadings (H2, H3)\n- Include practical tips or insights\n- Write in a conversational, informative tone\n- Add a compelling conclusion\n- Focus on providing value to readers\n- Include relevant examples where appropriate\n- Make it SEO-friendly with natural keyword usage\n\nCategory: {{ $json.category }}\nKeywords to include: {{ $json.keywords }}\n\nPlease format the content in HTML with proper heading tags (h2, h3), paragraph tags (p), and list tags (ul, ol) where appropriate.",
              "role": "user"
            }
          ]
        },
        "simplify": true,
        "options": {}
      },
      "id": "gemini-content",
      "name": "Generate Blog Content with Gemini",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1,
      "position": [
        900,
        300
      ],
      "credentials": {
        "googleGeminiApi": {
          "id": "google-gemini-api",
          "name": "Google Gemini API"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "url": "=https://api.unsplash.com/search/photos",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "query",
              "value": "={{ $('Select Random Title').item.json.keywords }}"
            },
            {
              "name": "per_page",
              "value": "5"
            },
            {
              "name": "orientation",
              "value": "landscape"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Client-ID {{ $env.UNSPLASH_ACCESS_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "id": "unsplash-search",
      "name": "Search Unsplash for Image",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        300
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Process Unsplash response and select best image\nconst unsplashData = $input.first().json;\nconst titleData = $('Select Random Title').item.json;\nconst geminiContent = $('Generate Blog Content with Gemini').item.json;\n\nlet selectedImage = null;\n\nif (unsplashData.results && unsplashData.results.length > 0) {\n  // Select the first high-quality image\n  const image = unsplashData.results[0];\n  selectedImage = {\n    url: image.urls.regular,\n    downloadUrl: image.urls.full,\n    alt: image.alt_description || titleData.title,\n    photographer: image.user.name,\n    photographerUrl: image.user.links.html,\n    unsplashUrl: image.links.html\n  };\n}\n\nreturn [{\n  json: {\n    title: titleData.title,\n    content: geminiContent.response || geminiContent.text || geminiContent,\n    category: titleData.category,\n    rowNumber: titleData.rowNumber,\n    featuredImage: selectedImage,\n    status: 'draft',\n    publishDate: new Date().toISOString()\n  }\n}];"
      },
      "id": "process-data",
      "name": "Process Blog Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.featuredImage ? $json.featuredImage.downloadUrl : '' }}",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "file"
            }
          }
        }
      },
      "id": "download-image",
      "name": "Download Featured Image",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1560,
        200
      ],
      "executeOnce": false,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "wordpressApi",
        "resource": "post",
        "operation": "create",
        "title": "={{ $json.title }}",
        "content": "={{ $json.content }}",
        "additionalFields": {
          "status": "draft",
          "categories": "={{ $json.category }}",
          "excerpt": "=Auto-generated blog post about {{ $json.title }}. Created with AI assistance.",
          "featuredMedia": "={{ $('Upload Featured Image').item.json.id || '' }}"
        }
      },
      "id": "wordpress-create",
      "name": "Create WordPress Post",
      "type": "n8n-nodes-base.wordpress",
      "typeVersion": 1,
      "position": [
        1780,
        300
      ],
      "credentials": {
        "wordpressApi": {
          "id": "wordpress-api",
          "name": "WordPress API"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "url": "={{ $env.WORDPRESS_URL }}/wp-json/wp/v2/media",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Basic {{ $env.WORDPRESS_AUTH_TOKEN }}"
            },
            {
              "name": "Content-Disposition",
              "value": "=attachment; filename=\"{{ $('Process Blog Data').item.json.title.replace(/[^a-zA-Z0-9]/g, '-').toLowerCase() }}.jpg\""
            }
          ]
        },
        "sendBody": true,
        "contentType": "binaryData",
        "options": {}
      },
      "id": "upload-image",
      "name": "Upload Featured Image",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1560,
        400
      ],
      "executeOnce": false,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "resource": "sheet",
        "operation": "update",
        "documentId": "={{ $env.GOOGLE_SHEET_ID }}",
        "sheetName": "Sheet1",
        "range": "=C{{ $json.rowNumber }}",
        "options": {
          "dataStructure": "object"
        },
        "dataToSend": "defineInNode",
        "valueInputMode": "raw",
        "rawData": "published"
      },
      "id": "update-sheet",
      "name": "Mark as Published in Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.6,
      "position": [
        2000,
        300
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "google-sheets-oauth",
          "name": "Google Sheets OAuth2 API"
        }
      },
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Every 6 Hours Trigger": {
      "main": [
        [
          {
            "node": "Get Blog Titles from Sheet",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Blog Titles from Sheet": {
      "main": [
        [
          {
            "node": "Select Random Title",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Select Random Title": {
      "main": [
        [
          {
            "node": "Generate Blog Content with Gemini",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Blog Content with Gemini": {
      "main": [
        [
          {
            "node": "Search Unsplash for Image",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Search Unsplash for Image": {
      "main": [
        [
          {
            "node": "Process Blog Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Process Blog Data": {
      "main": [
        [
          {
            "node": "Download Featured Image",
            "type": "main",
            "index": 0
          },
          {
            "node": "Upload Featured Image",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Download Featured Image": {
      "main": [
        [
          {
            "node": "Upload Featured Image",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Upload Featured Image": {
      "main": [
        [
          {
            "node": "Create WordPress Post",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create WordPress Post": {
      "main": [
        [
          {
            "node": "Mark as Published in Sheet",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "saveExecutionProgress": true,
    "saveManualExecutions": true,
    "timezone": "UTC"
  },
  "staticData": {},
